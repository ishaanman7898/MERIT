# Secrets and local config
# config.json holds API keys, SMTP password, and DB credentials.
# Each user creates their own from config.template.json — never commit yours.
config.json

# Local SQLite database
# data.db is a local cache. Cloud databases are the source of truth.
data.db

# Python cache
__pycache__/
*.pyc
*.pyo
.Python

# Virtual environments
venv/
.venv/
env/
.env

# IDE and OS
.DS_Store
.vscode/
*.swp

# Claude Code local state
.claude/

# Gemini local state
.gemini/

# Development and test files
tests/*.py

# Uploaded images and local assets
*.jpg
*.jpeg
*.png
*.gif
*.webp

# Excel exports and local data files
*.xlsx
*.xls
*.csv
